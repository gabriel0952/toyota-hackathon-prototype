# Backend reads this literal env file automatically; process variables take precedence.
# Never commit keys or use VITE_ for secrets.
LOCAL_DEMO=1
DECISION_DB=decision.db
DECISION_SOURCE_MODE=tdx_cache
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
# Only a project with paid billing disabled may be used for this zero-paid mode.
# Reconfirm when changing projects/keys. This flag does not inspect Google billing.
GEMINI_FREE_TIER_CONFIRMED=0
LLM_MAX_COST_USD=0
LLM_TEST_BUDGET_USD=0
LLM_MAX_TOKENS=12000
GENERATION_MODE=template
# Explicit llm mode additionally requires confirmed Free tier, both zero caps and key.
# Import/refresh verified source cache before evaluating; never falls back to seed.
